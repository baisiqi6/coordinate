# Coordinate runtime configuration
# This file is loaded by `python -m coordinate` (and `coordinate serve`) via
# python-dotenv. Existing process env vars take precedence (override=False).
#
# Do not commit the real `.env`. `.env` is in .gitignore. Use this file as
# a template only.

# Required for `coordinate serve` (the Discord daemon):
COORDINATOR_BOT_TOKEN=
COORDINATOR_CHANNEL_ID=
COORDINATOR_ALLOWED_USER_IDS=

# Optional, overrides the default SQLite database path
# ($HOME/.local/share/coordinate/coordinator.sqlite3):
# MULTI_AGENT_COORDINATOR_DB=/path/to/coordinator.sqlite3

# Optional, coordinate Python interpreter override used by run-daemon.sh:
# COORDINATOR_PYTHON_BIN=/path/to/python3
