# Coordinate Remote MCP streamable HTTP (R3) — loopback-only systemd unit.
#
# Fail-safe contract:
#  - The unit only starts when BOTH server-local files exist:
#    /etc/coordinate/mcp-http-clients.json (digest-only client policy) and
#    /etc/coordinate/mcp-http.env (root-owned, non-secret exact allowed
#    Host). An ordinary Coordinate deploy without both files never activates
#    this unit.
#  - A broken policy or env file makes the server exit non-zero with a
#    diagnostic journal; Restart=on-failure with a bounded StartLimit
#    prevents an infinite crash loop while keeping the failure visible.
#  - The process binds loopback only (127.0.0.1:8766) and never exposes the
#    control plane beyond the host.
#  - The exact allowed Host header is injected from the env file via
#    EnvironmentFile (never hardcoded here, never a wildcard; the CLI
#    rejects '*'). No plaintext bearer token ever lives in this unit, the
#    repo or argv: the policy file stores digests only.
[Unit]
Description=Coordinate Remote MCP HTTP (loopback control plane, R3)
ConditionPathExists=/etc/coordinate/mcp-http-clients.json
ConditionPathExists=/etc/coordinate/mcp-http.env
StartLimitIntervalSec=60
StartLimitBurst=3
After=network-online.target

[Service]
Type=simple
User=coord
Group=coord
EnvironmentFile=/etc/coordinate/mcp-http.env
ExecStart=/opt/coordinate/.venv/bin/coordinate --db /var/lib/coordinate/coord.sqlite3 mcp serve --transport streamable-http --host 127.0.0.1 --port 8766 --path /mcp --auth-file /etc/coordinate/mcp-http-clients.json --allowed-host ${MCP_ALLOWED_HOST}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/coordinate

[Install]
WantedBy=multi-user.target
